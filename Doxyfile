# Doxyfile for CUM (C++ Numeric Library)
PROJECT_NAME           = "CUM"
PROJECT_BRIEF          = "C++ Numeric Library"
PROJECT_LOGO           = 

OUTPUT_DIRECTORY       = build/docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Inputs
INPUT                  = include \
                         README.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp \
                         *.h \
                         *.ipp

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES

# Warning & Diagnostics
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

# Output formats (XML for doxybook2 -> MkDocs)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
